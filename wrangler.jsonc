{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "epson-print",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
